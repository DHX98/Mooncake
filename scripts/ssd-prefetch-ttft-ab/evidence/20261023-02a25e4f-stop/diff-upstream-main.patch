-bool isWordChar(char c) {
-    return std::isalnum(static_cast<unsigned char>(c)) || c == '_';
-}
-
-bool isAddressChar(char c) {
-    return std::isxdigit(static_cast<unsigned char>(c)) || c == ':' || c == '.';
