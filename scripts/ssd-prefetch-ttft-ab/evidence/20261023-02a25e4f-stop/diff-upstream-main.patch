-        static_cast<unsigned __int128>(metadata.TotalLength()) *
-        holding_replicas;
-    return charge > TenantQuotaAccount::kMaxChargedBytes
-               ? TenantQuotaAccount::kMaxChargedBytes
-               : static_cast<uint64_t>(charge);
