-    uint64_t last_offset = 0;
-    size_t last_length = 0;
-    uint64_t last_iova = 0;
-    int last_fd = -1;
-    int last_access = 0;
-};
-FakeMrVerbs fake_mr;
-
-ibv_mr* fakeRegMr(ibv_pd*, void* addr, size_t length, int) {
-    ++fake_mr.reg_mr_calls;
-    fake_mr.host_mr.addr = addr;
-    fake_mr.host_mr.length = length;
