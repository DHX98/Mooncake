+    UUID holder = PrepareHolderClient(*service, "prefetch_seg_3");
+    UUID other = PrepareHolderClient(*service, "prefetch_seg_3b");
+    ASSERT_TRUE(InjectLocalDiskOnlyKey(*service, holder, "pk3", 1024,
