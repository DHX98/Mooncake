+                           [&source](Replica& r) {
+                               if (source == nullptr && r.is_completed()) {
+                                   source = &r;
+                               }
+                           });
+    if (source == nullptr) {
+        return tl::make_unexpected(ErrorCode::REPLICA_IS_NOT_READY);
+    }
