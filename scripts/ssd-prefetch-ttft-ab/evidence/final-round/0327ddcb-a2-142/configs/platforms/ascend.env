# Platform profile: Ascend A2 (vllm-ascend + AscendStoreConnector).
# Sourced by env.sh when PLATFORM=ascend. Must define, for serve.sh:
#   platform_vllm_env  KV_JSON  VLLM_EXTRA_ARGS (array)  BLOCK_SIZE
# and for env.sh:
#   MOONCAKE_PROTOCOL  MOONCAKE_DEVICE_NAME

MOONCAKE_PROTOCOL="ascend"
MOONCAKE_DEVICE_NAME=""
BLOCK_SIZE="${BLOCK_SIZE:-128}"

KV_JSON='{"kv_connector":"AscendStoreConnector","kv_role":"kv_both","kv_load_failure_policy":"recompute","kv_connector_extra_config":{"lookup_rpc_port":"0","backend":"mooncake"}}'

VLLM_EXTRA_ARGS=(
  --kv-cache-dtype fp8
  --quantization ascend
  --tokenizer-mode deepseek_v4
  --enable-expert-parallel
)

platform_vllm_env() {
  export ASCEND_RT_VISIBLE_DEVICES="$NPU"
  export ACL_OP_INIT_MODE=1
  export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
  export HCCL_BUFFSIZE=1024
  export TASK_QUEUE_ENABLE=1
  export HCCL_OP_EXPANSION_MODE=AIV
  export HCCL_IF_IP="${FABRIC_IP:-127.0.0.1}"
  export GLOO_SOCKET_IFNAME="${SOCKET_IFNAME:-}"
  export TP_SOCKET_IFNAME="${SOCKET_IFNAME:-}"
  export HCCL_SOCKET_IFNAME="${SOCKET_IFNAME:-}"
  export HCCL_INTRA_ROCE_ENABLE=1
  unset ASCEND_ENABLE_USE_FABRIC_MEM || true
}
