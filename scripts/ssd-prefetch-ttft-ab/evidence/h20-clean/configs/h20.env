# Platform profile: NVIDIA H20 (upstream vLLM + Mooncake connector).
# Sourced by env.sh when PLATFORM=h20. Same interface as ascend.env.
#
# Knobs you most likely need to touch before running:
#   MODEL            an NVIDIA build of the model (the w8a8 weights are
#                    Ascend-only; use the FP8/BF16 build)
#   VLLM_EXTRA_ARGS  quantization/tokenizer flags for that build
#   KV_JSON          connector name — verify against your vLLM build
#                    (upstream: MooncakeStoreConnector)
#   MOONCAKE_PROTOCOL  "tcp" works everywhere; "rdma" if the NIC + MOONCAKE_DEVICE_NAME are set

MOONCAKE_PROTOCOL="${MOONCAKE_PROTOCOL:-tcp}"
MOONCAKE_DEVICE_NAME="${MOONCAKE_DEVICE_NAME:-}"
# DSV4 FlashMLA on this vLLM 0.23.0 rejects 128 (SWA page > full-MLA page).
# Prior working 179 serve omitted --block-size; 64 matches FlashMLA.
BLOCK_SIZE="${BLOCK_SIZE:-64}"

KV_JSON='{"kv_connector":"MooncakeStoreConnector","kv_role":"kv_both","kv_load_failure_policy":"recompute"}'

VLLM_EXTRA_ARGS=(
  --kv-cache-dtype fp8
)

platform_vllm_env() {
  export CUDA_VISIBLE_DEVICES="$NPU"
  # NCCL over TCP works everywhere; point these at the right NIC for RDMA:
  export NCCL_SOCKET_IFNAME="${SOCKET_IFNAME:-}"
  export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-1}"
  export NCCL_P2P_DISABLE="${NCCL_P2P_DISABLE:-0}"
  export VLLM_USE_V1=1
  export OMP_PROC_BIND=false
  export OMP_NUM_THREADS=10
}
